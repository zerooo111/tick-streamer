# Continuum Streamer Configuration
# Copy this file to .env and configure with your actual values
# IMPORTANT: Never commit real credentials to version control

# Sequencer connection settings
SEQUENCER_ADDR=your-sequencer-host:port
SEQUENCER_TLS=false
SEQUENCER_MTLS=false
# TLS Configuration (when SEQUENCER_TLS=true)
# SEQUENCER_SERVER_NAME=sequencer.example.com  # Server name for TLS verification
# SEQUENCER_CA_CERT=/path/to/ca-cert.pem       # Path to CA certificate file
# mTLS Configuration (when SEQUENCER_MTLS=true)
# SEQUENCER_CLIENT_CERT=/path/to/client-cert.pem  # Path to client certificate
# SEQUENCER_CLIENT_KEY=/path/to/client-key.pem    # Path to client private key

# ClickHouse database configuration (required)
CLICKHOUSE_HOST=your-clickhouse-host.clickhouse.cloud
CLICKHOUSE_PORT=9440
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=your-clickhouse-password

# Checkpoint persistence
CHECKPOINT_DSN=file:./checkpoint.db

# Batching configuration
BATCH_ROWS_TX=20000
BATCH_ROWS_TICK=1000
BATCH_MAX_WAIT_MS=100

# Retry settings
RETRY_BACKOFF_MIN_MS=200
RETRY_BACKOFF_MAX_MS=20000

# API server configuration
API_PORT=3001
REST_BASE_URL=http://your-rest-api-host:port/api/v1
MATCH_ENGINE_URL=http://your-match-engine-host:port/api/v1

# CORS configuration
CORS_ALLOWED_ORIGINS=http://your-frontend-host:port
CORS_ALLOW_CREDENTIALS=false

# Logging
LOG_LEVEL=info
DEBUG=false

# ClickHouse-specific settings
CLICKHOUSE_BATCH_SIZE=10000
CLICKHOUSE_FLUSH_INTERVAL=5s
CLICKHOUSE_COMPRESSION=lz4
CLICKHOUSE_CONNECT_TIMEOUT=10s