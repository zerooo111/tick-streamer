# Continuum Streamer Configuration
# Copy this file to .env and configure with your actual values
# IMPORTANT: Never commit real credentials to version control

# Sequencer connection settings
SEQUENCER_ADDR=your-sequencer-host:port
SEQUENCER_TLS=false
SEQUENCER_MTLS=false

# Database sink configuration
SINK_KIND=mock
# Examples:
# SINK_DSN=mock://
# SINK_DSN=clickhouse://user:pass@host:port/database
# SINK_DSN=postgres://user:pass@host:port/database
SINK_DSN=your-database-connection-string
CHECKPOINT_DSN=file:./checkpoint.db

# Batching configuration
BATCH_ROWS_TX=20000
BATCH_ROWS_TICK=1000
BATCH_MAX_WAIT_MS=100

# Retry settings
RETRY_BACKOFF_MIN_MS=200
RETRY_BACKOFF_MAX_MS=20000

# HTTP server settings
HTTP_BIND=0.0.0.0:8080

# API server configuration
API_PORT=3001
REST_BASE_URL=http://your-rest-api-host:port/api/v1
MATCH_ENGINE_URL=http://your-match-engine-host:port/api/v1

# CORS configuration
CORS_ALLOWED_ORIGINS=http://your-frontend-host:port
CORS_ALLOW_CREDENTIALS=false

# Logging
LOG_LEVEL=info
DEBUG=false

# ClickHouse-specific settings (connection details are in SINK_DSN)
CLICKHOUSE_BATCH_SIZE=10000
CLICKHOUSE_FLUSH_INTERVAL=5s
CLICKHOUSE_COMPRESSION=lz4
CLICKHOUSE_CONNECT_TIMEOUT=10s