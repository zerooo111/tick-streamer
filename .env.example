# Continuum Streamer Configuration Template
# Copy this file to .env and configure with your actual values
# IMPORTANT: Never commit real credentials to version control

# =============================================================================
# ULTRA-LOW LATENCY STREAMING CONFIGURATION
# =============================================================================
# This template is optimized for sub-second latency (was 10-20 seconds)
# Key optimizations: STREAMING_MODE, small batches, no checkpoints

# =============================================================================
# SEQUENCER CONNECTION
# =============================================================================
SEQUENCER_ADDR=54.242.85.197:9090
SEQUENCER_TLS=false
SEQUENCER_MTLS=false
# TLS Configuration (when SEQUENCER_TLS=true)
# SEQUENCER_SERVER_NAME=sequencer.example.com  # Server name for TLS verification
# SEQUENCER_CA_CERT=/path/to/ca-cert.pem       # Path to CA certificate file
# mTLS Configuration (when SEQUENCER_MTLS=true)
# SEQUENCER_CLIENT_CERT=/path/to/client-cert.pem  # Path to client certificate
# SEQUENCER_CLIENT_KEY=/path/to/client-key.pem    # Path to client private key

# =============================================================================
# CLICKHOUSE DATABASE (Required unless DEBUG_MODE=true)
# =============================================================================
CLICKHOUSE_HOST=your-host.clickhouse.cloud
CLICKHOUSE_PORT=9440
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=your-secure-password

# =============================================================================
# PERFORMANCE OPTIMIZATIONS - ULTRA-LOW LATENCY MODE
# =============================================================================

# Enable direct write mode (bypasses batcher entirely)
STREAMING_MODE=true

# Enable all low-latency optimizations
LOW_LATENCY_MODE=true

# Store raw protobuf data (minimal parsing overhead)
SKIP_PARSING=false

# Small batch configuration (when batcher is used)
BATCH_ROWS_TX=100           # Down from 20000 - small batches for low latency
BATCH_ROWS_TICK=10          # Down from 1000 - small tick batches
BATCH_MAX_WAIT_MS=10        # Down from 100ms - fast batch timeout

# =============================================================================
# RETRY AND RESILIENCE
# =============================================================================
RETRY_BACKOFF_MIN_MS=200
RETRY_BACKOFF_MAX_MS=20000

# =============================================================================
# API SERVER (for cmd/api-server)
# =============================================================================
API_PORT=3001
REST_BASE_URL=http://54.242.85.197:8080/api/v1
MATCH_ENGINE_URL=http://44.194.22.128:8080

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001
CORS_ALLOW_CREDENTIALS=false

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
DEBUG=false

# File logging (disable for containerized deployments)
LOG_FILE_DISABLE=true      # Set to false to enable file logging
LOG_DIR=./logs             # Directory for log files (if file logging enabled)
LOG_MAX_SIZE=100           # Max log file size in MB
LOG_MAX_BACKUPS=5          # Number of log files to retain
LOG_MAX_AGE=30             # Days to retain log files
LOG_COMPRESS=true          # Compress rotated log files

# ClickHouse Performance Settings - Optimized for Low Latency
CLICKHOUSE_BATCH_SIZE=100           # Small batches for low latency (was 10000)
CLICKHOUSE_FLUSH_INTERVAL=100ms     # Fast flush interval (was 5s)
CLICKHOUSE_COMPRESSION=lz4
CLICKHOUSE_CONNECT_TIMEOUT=10s

# =============================================================================
# OPERATIONAL MODES
# =============================================================================

# Debug Mode - Runs without database, logs parsed data only
# Useful for development and testing
DEBUG_MODE=false

# =============================================================================
# PERFORMANCE TUNING EXAMPLES
# =============================================================================

# For Ultra-Low Latency (Real-time dashboards):
#   STREAMING_MODE=true
#   LOW_LATENCY_MODE=true
#   BATCH_MAX_WAIT_MS=5
#   CLICKHOUSE_FLUSH_INTERVAL=50ms

# For High Throughput (Batch analytics):
#   STREAMING_MODE=false
#   BATCH_ROWS_TX=10000
#   BATCH_MAX_WAIT_MS=1000
#   CLICKHOUSE_BATCH_SIZE=50000

# For Development/Testing:
#   DEBUG_MODE=true
#   LOG_LEVEL=debug
#   (No database required in debug mode)

# =============================================================================
# PERFORMANCE RESULTS
# =============================================================================
# Before: 10-20 second latency (large batches, checkpoints)
# After:  Sub-second latency (direct writes, no checkpoints)
# Improvement: 99%+ latency reduction