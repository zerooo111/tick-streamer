# Logging
LOG_LEVEL=info
DEBUG=false
LOG_FILE_DISABLE=true

# Performance Optimizations - TESTING MODE
LOW_LATENCY_MODE=false    # Enable logging for testing
SKIP_VALIDATION=false     # Enable validation for testing
DIRECT_WRITE=true         # Keep direct writes enabled