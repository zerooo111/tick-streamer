# Continuum Streamer Configuration
# Copy this file to .env and configure with your actual values
# IMPORTANT: Never commit real credentials to version control

# Sequencer connection settings
SEQUENCER_ADDR=54.242.85.197:9090
SEQUENCER_TLS=false
SEQUENCER_MTLS=false

# Database Configuration - Supports timescaledb or debug modes
SINK_KIND=timescaledb

# TimescaleDB database configuration
TIMESCALEDB_HOST=kvnqoe2dsi.voh4py8gtv.tsdb.cloud.timescale.com
TIMESCALEDB_PORT=34344
TIMESCALEDB_DATABASE=tsdb
TIMESCALEDB_USERNAME=tsdbadmin
TIMESCALEDB_PASSWORD=kpobldruvft72drx
TIMESCALEDB_SSL_MODE=require
TIMESCALEDB_MAX_CONNECTIONS=50
TIMESCALEDB_CONNECT_TIMEOUT_SECONDS=30


# Unified batching configuration - OPTIMIZED FOR THROUGHPUT
BATCH_SIZE=2000        # Larger batches for better throughput (40x increase)
FLUSH_INTERVAL=200ms   # Longer flush interval for efficiency (40x increase)

# Async processing configuration
SINK_WORKERS=8         # Number of parallel sink workers
CHANNEL_BUFFER=10000   # Async channel buffer size

# Retry settings
RETRY_BACKOFF_MIN_MS=200
RETRY_BACKOFF_MAX_MS=20000

# API server configuration
API_PORT=3001
REST_BASE_URL=http://54.242.85.197:8080/api/v1
# MATCH_ENGINE_URL=https://mtchengine.fermilabs.xyz
MATCH_ENGINE_URL=http://44.194.22.128:8080

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001,http://localhost:4000,https://devnet1.fermilabs.xyz,https://staging.fermilabs.xyz
CORS_ALLOW_CREDENTIALS=false

# Logging
LOG_LEVEL=info
DEBUG=false



LOG_FILE_DISABLE=true

# Performance Optimizations - ULTRA-LOW LATENCY ENABLED
LOW_LATENCY_MODE=true    # Skip circuit breaker and reduce logging
SKIP_VALIDATION=true     # Skip tick validation for maximum speed
DIRECT_WRITE=true        # Bypass batching - immediate database writes